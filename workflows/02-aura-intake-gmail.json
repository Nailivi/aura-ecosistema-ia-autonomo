        },
        "text": "={{ '🚨 AURA Intake: no se pudo reenviar el correo ' + $('03 Preparar Payload Lead').item.json.gmail_message_id + ' al webhook principal.' }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
