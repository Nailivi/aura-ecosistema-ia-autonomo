              "value": 6000,
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        270,
        0
      ],
      "id": "f10399f5-7fac-5240-b26e-a64b97114006",
      "name": "02 Config Intake"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst cfg = $('02 Config Intake').first().json;\nconst f = $json.from?.value?.[0] ?? {};\nconst cuerpo = `${$json.subject ?? ''}\\n${$json.text ?? ''}`.trim().slice(0, Number(cfg.max_chars_mensaje));\nreturn { json: { fuente: 'Gmail', nombre: f.name ?? '', email: f.address ?? '', mensaje: cuerpo,\n  gmail_message_id: $json.id, gmail_thread_id: $json.threadId } };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        540,
        0
      ],
      "id": "fc2906f9-acf4-52bd-96a6-bc020a762251",
      "name": "03 Preparar Payload Lead"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('02 Config Intake').first().json.webhook_url_leads }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        810,
        0
      ],
      "id": "826ed38e-0432-53cf-91a7-ba7ea0dec0d0",
      "name": "04 Reenviar a Webhook Principal",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "AURA Webhook Token (Header Auth)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "markAsRead",
        "messageId": "={{ $('03 Preparar Payload Lead').item.json.gmail_message_id }}"
      },
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1080,
        0
      ],
      "id": "ab51593c-3cae-5a86-ba02-1647854ffde2",
      "name": "05 Marcar Correo Leido",
      "credentials": {
