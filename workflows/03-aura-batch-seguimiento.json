    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst cfg = $('S2 Config Lote').first().json;\nconst rows = $input.all().map(i => ({ id: i.json.id, f: i.json.fields ?? i.json }));\nconst system = `Eres ejecutivo comercial de ${cfg.empresa_nombre}. Escribe un correo de seguimiento breve (max 120 palabras), tono ${cfg.tono_marca}, sin inventar precios, plazos ni servicios. Termina con UNA pregunta que facilite responder. Firma: ${cfg.empresa_firma}. Responde SOLO JSON: {\"asunto\":string,\"cuerpo\":string}`;\nconst requests = rows.map(r => ({ custom_id: r.id, params: { model: cfg.modelo_claude_batch, max_tokens: Number(cfg.max_tokens_seguimiento), system,\n  messages: [{ role: 'user', content: `Lead: ${r.f.Nombre || 'cliente'} (${r.f.Empresa || 'sin empresa'})\\nNecesidad: ${r.f['Resumen IA'] || 'no registrada'}\\nServicio sugerido: ${r.f['Servicio sugerido'] || 'n/d'}\\nEnviado el: ${r.f['Enviado en'] || 'n/d'}` }] } }));\nreturn [{ json: { requests, n: requests.length, lead_ids: rows.map(r => r.id) } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        0
