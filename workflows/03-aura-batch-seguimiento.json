    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "\nconst cfg = $('C2 Config Recoleccion').first().json;\nconst lote = $('C3 Buscar Lote En Proceso').first().json;\nconst txt = $input.first().json.data ?? $input.first().json.body ?? '';\nconst out = [];\nfor (const line of String(txt).split('\\n').filter(l => l.trim())) {\n  let r; try { r = JSON.parse(line); } catch (e) { continue; }\n  const ok = r.result?.type === 'succeeded';\n  let asunto = '', cuerpo = '';\n  if (ok) { const t = (r.result.message.content || []).filter(c => c.type === 'text').map(c => c.text).join('');\n    const a = t.indexOf('{'), b = t.lastIndexOf('}'); try { const j = JSON.parse(t.slice(a, b + 1)); asunto = j.asunto; cuerpo = j.cuerpo; } catch (e) {} }\n  const tin = r.result?.message?.usage?.input_tokens ?? 0, tout = r.result?.message?.usage?.output_tokens ?? 0;\n  const costo = (tin / 1e6 * Number(cfg.precio_claude_premium_in) + tout / 1e6 * Number(cfg.precio_claude_premium_out)) * (1 - Number(cfg.descuento_batch));\n  out.push({ json: { lead_id: r.custom_id, ok: ok && !!cuerpo, tipo_resultado: r.result?.type, asunto, cuerpo, tokens_in: tin, tokens_out: tout,\n    costo_usd: Math.round(costo * 1e6) / 1e6, modelo: r.result?.message?.model ?? '', lote_record_id: lote.id } });\n}\nreturn out.length ? out : [{ json: { lead_id: '', ok: false, tipo_resultado: 'sin_resultados', lote_record_id: lote.id, costo_usd: 0 } }];\n"
      },
